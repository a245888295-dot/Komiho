<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读器牛皮纸背景：无缝平铺纹理。PNG 在 drawable-nodpi，避免系统按密度缩放
  导致平铺网格尺寸随设备漂移。基色 #C6AA7C 与 ReaderTheme.KRAFT_STYLE 的
  页面滤镜白场一致，页面与 letterbox 才能同色衔接。
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/reader_bg_kraft_tile"
    android:tileMode="repeat"
    android:antialias="true" />
